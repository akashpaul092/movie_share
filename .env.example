# Copy to ".env" in the project root and adjust values. Never commit ".env".
# Docker Compose reads ".env" automatically for variable substitution.
# Optional: host port for the app container (full stack: docker compose up --build)
# APP_HOST_PORT=8081

# --- PostgreSQL (docker-compose + Spring) ---
# The password below is baked into Postgres only on FIRST start of an empty volume.
# If you change POSTGRES_PASSWORD later, either run: docker compose down -v (wipes DB)
# or set SPRING_DATASOURCE_PASSWORD to match whatever password the volume was created with.
POSTGRES_USER=movieshare
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=movieshare

# Spring JDBC: SPRING_DATASOURCE_PASSWORD MUST equal POSTGRES_PASSWORD (same string).
# URL host/port: localhost + 5433 when the app runs on the host; Compose overrides URL for the app container.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/movieshare
SPRING_DATASOURCE_USERNAME=movieshare
SPRING_DATASOURCE_PASSWORD=change-me-in-production

# --- Redis ---
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6380

# --- Optional: app (Spring Boot binds SERVER_ADDRESS to server.address) ---
# SERVER_PORT=8081
# SERVER_ADDRESS=0.0.0.0
# MOVIESHARE_CORS_ALLOWED_ORIGIN_PATTERNS=https://yourdomain.com
# MOVIESHARE_RATE_LIMIT_ROOM_CREATE=20
